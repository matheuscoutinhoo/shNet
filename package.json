{
  "name": "shlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/matheuscoutinhoo/shNet.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @shlab/api\" \"npm run dev -w @shlab/web\"",
    "start": "npm run start -w @shlab/api",
    "build": "npm run typecheck && npm run build -w @shlab/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretest:e2e": "tsx scripts/prepare-e2e.ts",
    "db:migrate": "npm run migrate -w @shlab/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "tsx scripts/benchmark-scale.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts backup",
    "restore": "tsx --env-file-if-exists=.env scripts/backup.ts restore",
    "test:postgres": "tsx scripts/test-postgres.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "railway": "3.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
