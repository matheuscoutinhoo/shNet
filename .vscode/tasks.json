    {
      "label": "shLab: Audit",
      "type": "shell",
      "command": "npm",
      "args": ["audit", "--audit-level=moderate"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "shLab: Development",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "shLab: Format Check",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format:check"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "shLab: Format Verified Files",
      "type": "shell",
      "command": "npm",
      "args": [
        "exec",
        "--",
        "prettier",
        "--write",
        ".vscode/tasks.json",
        "apps/api/src/app.ts",
        "tests/e2e/lab.spec.ts"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "shLab: Engine Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "tests/engine.test.ts"],
      "isBackground": false,
      "problemMatcher": [],
