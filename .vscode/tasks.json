{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "shLab: E2E MVP 1",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:e2e", "--", "--grep", "cadastro"],
      "isBackground": false,
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "shLab: Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "isBackground": false,
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "shLab: Build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "isBackground": false,
      "problemMatcher": [
        {
          "base": "$tsc",
          "applyTo": "allDocuments"
        }
      ],
      "group": "build"
    },
    {
      "label": "shLab: Lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "isBackground": false,
      "problemMatcher": []
