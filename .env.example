# Copy to .env. Local PostgreSQL/WASM mode; not for production.
DATABASE_MODE=embedded
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
# For Docker Compose dependencies, replace DATABASE_MODE with server and uncomment:
# DATABASE_URL=postgresql://shlab:shlab_dev_only@127.0.0.1:5432/shlab
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# Railway: use service/shared variables, never upload this file with secrets.
# NODE_ENV=production
# DATABASE_MODE=server
# HOST=::
# PORT is provided by Railway (the image defaults to 8080).
# APP_ORIGIN=https://your-public-domain (defaults to https://RAILWAY_PUBLIC_DOMAIN)
# Email is optional. Production defaults to none; development writes .data/mail.
# MAIL_PROVIDER=none
# Optional email verification/password recovery (requires an accessible SMTP server):
# MAIL_PROVIDER=smtp
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=configure-as-a-sealed-variable
# SMTP_PASSWORD=configure-as-a-sealed-variable
# MAIL_FROM=shLab <your-sender@your-domain>
# TRUSTED_PROXY_CIDRS=only-the-verified-proxy-IPs-or-CIDRs
# METRICS_TOKEN=random-secret-with-at-least-32-characters
# BACKUP_STATUS_FILE=/backup-status/status.json
# BACKUP_KEY=base64-of-32-random-bytes-stored-separately
# RESTORE_DATABASE_URL=postgresql://user:encoded-password@host/empty_restore_database
# RESTORE_CONFIRM_DATABASE=empty_restore_database
# See docs/production-operations.md for encrypted backups and monitoring.
# See docs/railway.md for deployment without email and optional SMTP.
